# Copy to `.env` and fill in values. Do not commit `.env`.

# Neon (or any Postgres) — non-pooling URL also works for drizzle-kit
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Min 32 chars — generate: openssl rand -hex 32
SESSION_SECRET=

# Optional: Resend for credential emails when HR creates dev/tester users
RESEND_API_KEY=
MAIL_FROM="WorkFlowGuard <onboarding@resend.dev>"
APP_LOGIN_URL=http://localhost:3000/login

# Legacy flags (app uses live DB metrics; leave false)
USE_MOCK_DATA=false
NEXT_PUBLIC_USE_MOCK=false
