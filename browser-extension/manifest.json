{
  "manifest_version": 3,
  "name": "WorkFlowGuard Tracker",
  "version": "1.0.0",
  "description": "Reports active tab URLs to your WorkFlowGuard ticket while tracking is on (optional break mode).",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WorkFlowGuard Tracker"
  }
}
